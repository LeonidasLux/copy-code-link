{
  "name": "copy-code-link",
  "displayName": "Copy Code Link",
  "description": "拷贝选中代码或光标行的工作区相对路径与行号链接到剪贴板",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copyCodeLink.copy",
        "title": "Copy Code Link: 拷贝代码链接"
      }
    ],
    "keybindings": [
      {
        "command": "copyCodeLink.copy",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/codeLink.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.85.0",
    "typescript": "^5.5.0"
  }
}
